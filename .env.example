# =====================================================================
# Configuración del sistema J.A.N.E.  — copia este archivo como .env y completa los valores.
# El .env NUNCA se sube a un repositorio ni a una carpeta pública (está en .gitignore).
# =====================================================================

# ---- Base de datos (PostgreSQL) ----
# En el servidor NO uses el usuario "postgres": crea uno solo para la aplicación, por ejemplo:
#   CREATE ROLE jane_app LOGIN PASSWORD '<clave larga y aleatoria>';
#   GRANT CONNECT ON DATABASE sistema_asistencia TO jane_app;
#   GRANT USAGE ON SCHEMA public TO jane_app;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO jane_app;
#   GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO jane_app;
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema_asistencia
DB_USER=jane_app
DB_PASS=
# Conexión cifrada: vacío en tu PC; "require" en un hosting (Neon lo exige)
DB_SSLMODE=

# Alternativa en una sola línea (la que entrega Neon). Si existe, reemplaza a las DB_* de arriba:
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---- Entorno ----
# production: oculta los errores al usuario (se guardan en storage/logs) y activa HSTS con HTTPS.
# En el servidor: APP_ENV=production y APP_DEBUG=false. En tu PC puedes usar APP_DEBUG=true.
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Caracas
# Dónde se guardan los errores: "archivo" (storage/logs/php-error.log) o "stderr" (registro de Render/Docker)
APP_LOG=archivo

# ---- Sesión ----
# Minutos sin actividad antes de cerrar la sesión
SESSION_IDLE_MINUTES=30

# ---- Registro de cuentas desde el login ----
# true: cualquiera puede pedir una cuenta (queda pendiente hasta que la directiva la apruebe).
# false: el formulario se oculta y la ruta responde 404.
REGISTRO_ABIERTO=true

# ---- Proxy inverso ----
# true SOLO si el sistema está detrás de Nginx/Apache/balanceador que agrega X-Forwarded-For y
# X-Forwarded-Proto. Con false se usa la IP de la conexión (si se activa sin proxy, cualquiera
# podría falsificar su IP y saltarse el bloqueo de intentos de login).
# En Render va en true: Render siempre pone su proxy delante de la aplicación.
TRUST_PROXY=false
